# Скопируйте этот файл в backend/.env и при необходимости поменяйте значения.
# Настоящий .env в репозиторий не коммитится.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=road_marking
POSTGRES_USER=road_marking
POSTGRES_PASSWORD=road_marking

# Откуда разрешены запросы к API, через запятую
CORS_ORIGINS=http://localhost:5173
